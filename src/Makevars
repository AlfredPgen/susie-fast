PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS)
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS) $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)

# No FMA contraction in the susie-fast kernels (they must repeat R's
# floating-point operations exactly). The upstream sources keep the
# compiler defaults, so their results do not change.
susie_fast.o: PKG_CXXFLAGS += -ffp-contract=off
fast_%.o: PKG_CXXFLAGS += -ffp-contract=off
